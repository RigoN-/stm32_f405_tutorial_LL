#######################################################################
.PHONY: all clean flash erase  start openocd debug

all: $(OUTPATH) $(PROJECT).bin $(PROJECT).hex $(PROJECT).asm

clean:
	@if exist $(OBJ_DIR_WIN) $(RM) $(OBJ_DIR_WIN)
	
flash:	
	"$(ST_LINK)"  -P $(PROJECT).bin 0x08000000 -V "after_programming" -Rst
	
start:	
	"$(ST_LINK)" -run 0x08000000

$(OUTPATH):
	@if not exist $(OBJ_DIR_WIN) $(MKDIR) $(OBJ_DIR_WIN)
	

$(PROJECT).elf: $(OBJS)
	@echo --------------------Linker_START-------------------------------
	$(LD) $(LDFLAGS) $(OBJS) -o $@
	@echo --------------------Linker_COMLITE-----------------------------
	@echo --------------------Memory_FULL_START--------------------------
	$(SIZE) -A $@
	@echo --------------------Memory_FULL_END----------------------------
	@echo --------------------SECTION Memory_START-----------------------
	$(SIZE) -B $@
	@echo --------------------SECTION Memory_END-------------------------
	@echo    TABLE comments:
	@echo  - End size  FLASH = text + data
	@echo  - End size  RAM   = data + bss
	@echo ---------------------------------------------------------------

$(OUTPATH)%.o: %.c
	@echo --------------------Compiler_START------------------------------
	$(CC)  $(CFLAGS) -c $<  -o $@ 
	@echo --------------------Compiler_END--------------------------------

$(OUTPATH)%.o: %.s
	$(CC) $(CFLAGS) -c $< -o $@ 

%.bin: %.elf
	$(OBJCOPY) -O binary $< $@
	
%.hex: %.elf
	$(OBJCOPY) -O ihex $< $@

%.asm: %.elf
	"$(OBJDUMP).exe" -dhw $< > $@
	
# 1. Запуск сервера OpenOCD. 
# Запускается в первой консоли Windows и держит связь с платой.
openocd:
	@echo [OPENOCD] RUN Server link with ST-Link V2...
	$(OPENOCD) $(OPENOCD_ARGS)

# 2. Запуск интерактивной консольной отладки GDB.
# Запускается во второй консоли Windows. На лету генерирует команды для старта.
debug: $(PROJECT).elf
	@echo target remote localhost:3333 > $(GDB_INIT_FILE)
	@echo monitor reset halt >> $(GDB_INIT_FILE)
	@echo load >> $(GDB_INIT_FILE)
	@echo monitor reset halt >> $(GDB_INIT_FILE)
	@echo [GDB] Run console debuger...
	"$(GDB)" -tui -x $(GDB_INIT_FILE) $(PROJECT).elf

