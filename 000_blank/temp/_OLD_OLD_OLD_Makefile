LDFLAGS = -static $(MCUFLAGS) 
LDFLAGS_EXTRA =  -nodefaultlibs 
LDFLAGS_STUB = --specs=nano.specs --specs=nosys.specs
LDFLAGS_RELAX = -Wl,--relax
#LDFLAGS_STD_LIB += -Wl,--start-group -lgcc -lc -lg -Wl,--end-group 
LD_SCRIPT += -T $(CORE)/STM32_f405_linker_script.ld
LDFLAGS_MAP = -Wl,-Map=$(PROJECT).map,--cref
LDFLAGS_GC_SECT = -Wl,--gc-sections 
LDFLAGS_INFO = -Wl,--print-memory-usage

#ELEASE mode
LDFLAGS += $(LDFLAGS_EXTRA) $(LDFLAGS_STUB)  $(LD_SCRIPT) $(LDFLAGS_RELAX) $(LDFLAGS_MAP) $(LDFLAGS_GC_SECT) $(LDFLAGS_INFO)  $(OPTIMIZE_FLAGS)
#EDEBUG mode
#LDFLAGS += $(LDFLAGS_STUB)  $(LD_SCRIPT)  $(LDFLAGS_MAP) $(LDFLAGS_GC_SECT) $(LDFLAGS_INFO) 
