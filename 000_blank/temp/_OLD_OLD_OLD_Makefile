#PLIB_LL_SRC = $(PLIB)/HAL/src
LIBS = ../../extrn_lib
#####################################################
# Toolchain:
# Compiler/Assembler/Linker/etc
PATH_GCC=../../../tools/gcc-arm-none-eabi/bin
PATH_ST_LINK=../../../tools\ST-Link\ST-LINK_Utility
PREFIX = $(PATH_GCC)/arm-none-eabi
CC = $(PREFIX)-gcc
AS = $(PREFIX)-as
AR = $(PREFIX)-ar
LD = $(PREFIX)-gcc
NM = $(PREFIX)-nm
OBJCOPY = $(PREFIX)-objcopy
OBJDUMP = $(PREFIX)-objdump
READELF = $(PREFIX)-readelf
SIZE = $(PREFIX)-size
GDB = $(PREFIX)-gdb
OPENOCD=openocd
ST_LINK=$(PATH_ST_LINK)/ST-LINK_CLI.exe
#######################################################################
# Command:
#linux 
#RM = rm -f
#windows 
RM_WIN_FILES= ..\..\driver\stm32f4xx\core\*.o ..\..\driver\stm32f4xx\plib\LL\src\*.o .\*.o
RM = del
