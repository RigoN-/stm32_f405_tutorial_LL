#######################################################################
.PHONY: all clean flash erase 

all:   $(PROJECT).bin $(PROJECT).hex $(PROJECT).asm

clean:
	$(RM) $(RM_WIN_FILES) .\_build\$(NAME).elf .\_build\$(NAME).bin .\_build\$(NAME).asm .\_build\$(NAME).hex	
	
flash:	
	"$(ST_LINK)"  -P $(PROJECT).bin 0x08000000 -V "after_programming" -Rst
	
start:	
	"$(ST_LINK)" -run 0x08000000


	

$(PROJECT).elf: $(OBJS)

%.o: %.c %.s
	$(CC)  $(CFLAGS) -c $<  -o $@ 


%.elf:	
	$(LD) $(OBJS) $(LDFLAGS) -o $@
	$(SIZE) -A $@

%.bin: %.elf
	$(OBJCOPY) -O binary $< $@
	
%.hex: %.elf
	$(OBJCOPY) -O ihex $< $@

%.asm: %.elf
	"$(OBJDUMP).exe" -dhw $< > $@