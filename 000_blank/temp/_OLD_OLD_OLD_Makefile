OPTIMIZE_FLAGS += -flto
OPTIMIZE_FLAGS += -fdata-sections -ffunction-sections
OPTIMIZE_FLAGS += -fsingle-precision-constant 
OPTIMIZE_FLAGS += -fno-math-errno -ffast-math
